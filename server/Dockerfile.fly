FROM python:3.10-slim

# Install system dependencies for OpenCV, MediaPipe, and ML libraries
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgtk-3-0 \
    libgl1 \
    libfontconfig1 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libxrandr2 \
    libasound2t64 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for headless operation
ENV DISPLAY=:99
ENV QT_QPA_PLATFORM=offscreen
ENV OPENCV_IO_ENABLE_JASPER=true

WORKDIR /server

# Install Python dependencies - CPU only (cached layer)
COPY server/requirements.prod.txt .
RUN pip install --no-cache-dir -r requirements.prod.txt

# Copy application code
COPY server/app/ ./app/

# Bundle ML models directly into the image
RUN mkdir -p ./ml/saved_models
COPY ml/saved_models/ ./ml/saved_models/

ENV PYTHONPATH=/server

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
